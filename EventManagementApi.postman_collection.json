{
  "info": {
    "name": "EventManagementApi",
    "description": "Requests for the Event Management API. Set `baseUrl` to the API address and `eventId` to an existing event.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7172/api/event"
    },
    {
      "key": "eventId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Get schedule (all events)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/schedule",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "schedule"
          ]
        }
      }
    },
    {
      "name": "Create event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Tech Conference\",\n  \"startDate\": \"2026-12-01T09:00:00\",\n  \"endDate\": \"2026-12-01T17:00:00\",\n  \"maxRegistrations\": 100,\n  \"location\": \"Tel Aviv\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Get event by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/{{eventId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{eventId}}"
          ]
        }
      }
    },
    {
      "name": "Update event",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/{{eventId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{eventId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Tech Conference 2026\",\n  \"startDate\": \"2026-12-01T09:00:00\",\n  \"endDate\": \"2026-12-01T17:00:00\",\n  \"maxRegistrations\": 150,\n  \"location\": \"Tel Aviv\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete event",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/{{eventId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{eventId}}"
          ]
        }
      }
    },
    {
      "name": "Register user to event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/{{eventId}}/registration",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{eventId}}",
            "registration"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice\",\n  \"dateOfBirth\": \"1990-01-01\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Get event participants",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/{{eventId}}/registration",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{eventId}}",
            "registration"
          ]
        }
      }
    },
    {
      "name": "Get event weather",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/{{eventId}}/weather",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{eventId}}",
            "weather"
          ]
        }
      }
    }
  ]
}